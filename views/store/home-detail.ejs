<%- include('../partials/head') %>
</head>

<body class="bg-gray-100">

<%- include('../partials/nav') %>

<main class="container mx-auto bg-white shadow-md rounded-lg mt-6 max-w-5xl">

  <!-- Heading -->
  <h2 class="text-2xl text-red-500 font-semibold text-center py-5">
    Details of <%= home.houseName %>
  </h2>

  <!-- Content -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 px-6 pb-6">

    <!-- Image -->
    <div class="rounded-md overflow-hidden">
      <img 
        src="<%= home.photo %>" 
        alt="<%= home.houseName %>" 
        class="w-full h-80 object-cover"
      >
    </div>

    <!-- Right Side -->
    <div class="space-y-4 text-sm">

      <div class="border-b pb-3">
        <h3 class="font-semibold text-gray-800 mb-1">Description</h3>
        <p class="text-gray-600"><%= home.description %></p>
      </div>

      <div class="border-b pb-3">
        <h3 class="font-semibold text-gray-800 mb-1">Location</h3>
        <p class="text-gray-600 capitalize"><%= home.location %></p>
      </div>

      <div class="border-b pb-3">
        <h3 class="font-semibold text-gray-800 mb-1">Price</h3>
        <p class="text-green-600 font-semibold">
          $<%= home.price %> / night
        </p>
      </div>

      <div class="border-b pb-3">
        <h3 class="font-semibold text-gray-800 mb-1">Rating</h3>
        <div class="flex items-center text-yellow-500">
          ★ <span class="ml-2 text-gray-700"><%= home.rating %> / 5</span>
        </div>
      </div>
      <br/>

      <!-- Favourite -->
      <div class="pt-1">
        <%- include('../partials/favourite') %>
      </div>

    </div>
  </div>
</main>

</body>
</html>
